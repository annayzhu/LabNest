DATABASE_URL="postgresql://labnest:labnest@localhost:5432/labnest?schema=public"
LABNEST_ATTACHMENT_ROOT="./storage/attachments"
# Encrypts stored AI provider API keys. Generate one with: openssl rand -hex 32
LABNEST_AI_ENCRYPTION_KEY="replace-with-32-byte-base64-or-hex-key"
NEXT_PUBLIC_APP_NAME="LabNest"

# Optional standalone-tool endpoint overrides. Leave blank to use the managed releases.
QPCR_LAYOUT_TOOL_URL=""
CNV_LAYOUT_TOOL_URL=""
QPCR_ANALYSIS_TOOL_URL=""
CNV_ANALYSIS_TOOL_URL=""

# Independent Studio URL, reachable from client devices; no data or credentials appended.
VISUALIZATION_STUDIO_URL=""

# Daily backups (Settings → Backup). Default: ~/LabNest备份 on this computer, outside Docker.
# LABNEST_BACKUP_HOST_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/LabNest备份
