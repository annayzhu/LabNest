+  function exportSvg() {
+    downloadBlob(new Blob([serializedSvg()], { type: "image/svg+xml;charset=utf-8" }), `${exportFileStem}-${safeFileName(target)}-relative-expression.svg`);
+  }
+
+  async function exportPng() {
