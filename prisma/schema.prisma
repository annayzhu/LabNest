// LabNest V1 schema.
// Prisma 7 keeps the datasource URL in prisma.config.ts; this schema remains
// provider-focused and is designed for local PostgreSQL via Docker Compose.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntrySourceType {
  text
  photo
  file
  voice
  manual
}

enum RecordLifecycleStatus {
  draft
  recorded
  submitted
  reviewed
}

enum ExperimentStatus {
  planned
  running
  completed
  failed
  archived
}

enum ResearchPlanStatus {
  draft
  active
  paused
  completed
  archived
}

enum ResultSourceType {
  manual
  protocol_template
  file_import
  tool
  analysis
}

enum ResultQualityStatus {
  not_assessed
  pass
  warning
  fail
}

enum ResultValidationStatus {
  not_applicable
  incomplete
  valid
  warning
  invalid
}

enum ResultDatasetStorageMode {
  managed_file
  external_reference
}

enum ReportStatus {
  draft
  ready_for_review
  final
  archived
}

enum ProtocolAvailability {
  draft
  active
  retired
  archived

  @@map("ProtocolStatus")
}

enum ProtocolReviewStage {
  draft
  ready_for_review
  reviewed
}

enum ProtocolScope {
  general
  project
}

enum ProtocolVersionSourceType {
  manual
  docx_import
  derived
}

enum ExperimentProtocolRole {
  primary
  supporting
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum EntityType {
  plasmid
  primer
  oligo
  cell_line
  antibody
  protein
  reagent
  compound
  bacteria
  mixture
  sample
  other
}

enum ObjectStatus {
  active
  inactive
  archived
}

enum SampleLifecycleStatus {
  registered
  prepared
  stocked
  in_use
  depleted
  discarded
  archived
}

enum SampleLifecycleEventType {
  register
  collect
  prepare
  aliquot
  receive
  store
  transfer
  thaw
  refreeze
  consume
  qc
  discard
  result_link
  note
}

enum InventoryLocationType {
  freezer
  fridge
  shelf
  box
  position
  drawer
  plate
  rack
  room
  other
}

enum InventoryTransactionType {
  add
  consume
  transfer
  adjust
  discard
  receive
  aliquot
  thaw
  refreeze
  qc
  return
}

enum PurchaseStatus {
  planned
  ordered
  received
  stocked
  cancelled
}

enum ProcurementInquiryStatus {
  draft
  quoted
  selected
  converted
  archived
}

enum ProcurementQuoteLineStatus {
  candidate
  selected
  not_selected
  expired
  rejected
  duplicate
  future_candidate
  converted
}

enum ProcurementSourceType {
  excel
  manual
  school_template
}

enum SequenceType {
  DNA
  RNA
  Protein
}

enum SequenceOwnershipScope {
  library
  project
}

enum SequenceEntryClass {
  nucleic_acid
  amino_acid
  oligo
}

enum SequencePairType {
  primer_pair
  sirna_duplex
}

enum SequencePairRole {
  forward
  reverse
  sense
  antisense
}

enum SequenceWorkflowType {
  alignment
  assembly
  crispr
}

enum SequenceDesignType {
  plasmid
  primer
  probe
  siRNA
  shRNA
  gRNA
  oligo
  peptide
  protein
  fragment
  other
}

enum SequenceLifecycleStatus {
  draft
  active
  inactive
  archived
}

enum SequenceValidationStatus {
  unverified
  validation_in_progress
  validated_recommended
  validated_limited
  validated_not_recommended
  inconclusive
}

enum SequenceTopology {
  linear
  circular
}

enum SequenceStrandedness {
  single
  double
  unknown
}

enum SequenceSourceType {
  manual
  fasta_import
  csv_import
  xlsx_import
}

enum SequenceCollectionType {
  primer_pair
  sirna_duplex
  primer_panel
  sirna_series
  sequence_series
  shrna_construct
  probe_panel
  plasmid_construct
  peptide_set
  other
}

enum LinkCreatedBy {
  user
  system
  ai
}

enum ProposedActionSourceType {
  ai
  protocol
  entry
  import
  manual
  system
}

enum ProposedActionStatus {
  pending
  accepted
  rejected
  edited
  executed
}

enum ProposedActionType {
  create_experiment
  update_experiment
  consume_inventory
  create_entity
  create_result
  create_purchase_request
  receive_purchase
  link_attachment
  link_item
  create_inventory_item
  create_protocol_run
}

enum AIProviderType {
  openai
  anthropic
  openai_compatible
  manual_copy_paste
}

enum ReferenceProviderType {
  zotero
  endnote
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  keyInformation String?
  status         ProjectStatus @default(active)
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entries              Entry[]
  researchPlans        ResearchPlan[]
  experiments          Experiment[]
  protocols            Protocol[]
  protocolAssociations ProjectProtocol[]
  entities             Entity[]
  sequences            Sequence[]
  sequencePairs        SequencePair[]
  sequenceCollections  SequenceCollection[]
  sequenceWorkflows    SequenceWorkflow[]
  results              Result[]
  reports              Report[]
  procurementInquiries ProcurementInquiry[]

  @@index([status])
  @@index([createdAt])
}

model ResearchPlan {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  code           String             @unique
  title          String
  objective      String?
  hypothesis     String?
  rationale      String?
  keyInformation String?
  design         String?
  contentJson    Json               @default("{}")
  status         ResearchPlanStatus @default(draft)
  tags           String[]           @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  entries     Entry[]
  experiments Experiment[]
  protocols   ResearchPlanProtocol[]
  results     Result[]
  reports     Report[]

  @@index([projectId])
  @@index([status])
}

model ResearchPlanProtocol {
  researchPlanId String
  researchPlan   ResearchPlan @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  protocolId     String
  protocol       Protocol     @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())

  @@id([researchPlanId, protocolId])
  @@index([protocolId])
}

model Entry {
  id             String                @id @default(cuid())
  title          String
  body           String
  occurredAt     DateTime              @default(now())
  projectId      String?
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  researchPlanId String?
  researchPlan   ResearchPlan?         @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  tags           String[]              @default([])
  moodStatus     String?
  sourceType     EntrySourceType       @default(text)
  recordStatus   RecordLifecycleStatus @default(draft)
  contentJson    Json                  @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([recordStatus])
  @@index([occurredAt])
  @@index([projectId])
  @@index([researchPlanId])
  @@index([archivedAt])
}

model Experiment {
  id                       String                @id @default(cuid())
  runCode                  String                @unique
  title                    String
  projectId                String?
  project                  Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  researchPlanId           String?
  researchPlan             ResearchPlan?         @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  status                   ExperimentStatus      @default(planned)
  recordStatus             RecordLifecycleStatus @default(draft)
  date                     DateTime              @default(now())
  purpose                  String?
  contentJson              Json                  @default("{}")
  /// Derived plain-text mirror of purpose + contentJson. Written on every save,
  /// never edited directly; exists only so search does not need per-section columns.
  searchText               String?
  protocolSnapshotJson     Json                  @default("{}")
  primaryProtocolVersionId String?               @map("protocolVersionId")
  primaryProtocolVersion   ProtocolVersion?      @relation("PrimaryExperimentProtocol", fields: [primaryProtocolVersionId], references: [id], onDelete: SetNull)
  tags                     String[]              @default([])
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  protocolRun           ProtocolRun?
  steps                 ExperimentStep[]
  inventoryTransactions InventoryTransaction[]
  sampleEvents          SampleLifecycleEvent[]
  results               Result[]
  protocolVersions      ExperimentProtocolVersion[]

  @@index([status])
  @@index([recordStatus])
  @@index([date])
  @@index([projectId])
  @@index([researchPlanId])
  @@index([primaryProtocolVersionId])
}

model ExperimentProtocolVersion {
  experimentId      String
  experiment        Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  protocolVersionId String
  protocolVersion   ProtocolVersion        @relation(fields: [protocolVersionId], references: [id], onDelete: Restrict)
  role              ExperimentProtocolRole @default(supporting)
  order             Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@id([experimentId, protocolVersionId])
  @@index([protocolVersionId])
  @@index([experimentId, order])
}

model Protocol {
  id             String                @id @default(cuid())
  humanCode      String                @unique
  title          String
  canonicalTitle String?
  shortTitle     String?
  englishTitle   String?
  description    String?
  scope          ProtocolScope         @default(general)
  availability   ProtocolAvailability  @default(draft) @map("status")
  recordStatus   RecordLifecycleStatus @default(draft)
  projectId      String?
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags           String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  versions            ProtocolVersion[]
  researchPlans       ResearchPlanProtocol[]
  projectAssociations ProjectProtocol[]

  @@index([availability])
  @@index([scope])
  @@index([recordStatus])
  @@index([projectId])
}

/// Reusable library Protocols may be associated with several Projects without
/// changing their ownership/context (`Protocol.projectId`).
model ProjectProtocol {
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  protocolId String
  protocol   Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, protocolId])
  @@index([protocolId])
}

model RecordCodeCounter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model ProtocolVersion {
  id                   String                    @id @default(cuid())
  protocolId           String
  protocol             Protocol                  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  revision             Int                       @map("versionNumber")
  displayVersion       String                    @default("0.1")
  reviewStage          ProtocolReviewStage       @default(draft)
  recordStatus         RecordLifecycleStatus     @default(draft)
  previousVersionId    String?
  previousVersion      ProtocolVersion?          @relation("ProtocolRevisionHistory", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions         ProtocolVersion[]         @relation("ProtocolRevisionHistory")
  derivedFromVersionId String?
  derivedFromVersion   ProtocolVersion?          @relation("ProtocolDerivation", fields: [derivedFromVersionId], references: [id], onDelete: SetNull)
  derivedVersions      ProtocolVersion[]         @relation("ProtocolDerivation")
  adaptationRationale  String?
  changeSummary        String?
  sourceType           ProtocolVersionSourceType @default(manual)
  sourceFileName       String?
  sourceFileChecksum   String?
  sourceImportedAt     DateTime?
  title                String
  purpose              String?
  background           String?
  scope                String?
  notes                String?
  parametersJson       Json                      @default("[]")
  materialsJson        Json                      @default("[]")
  equipmentJson        Json                      @default("[]")
  stepsJson            Json                      @default("[]")
  consumptionRulesJson Json                      @default("[]")
  resultTemplatesJson  Json                      @default("[]")
  contentJson          Json                      @default("{}")
  createdAt            DateTime                  @default(now())

  primaryExperiments Experiment[]                @relation("PrimaryExperimentProtocol")
  experimentLinks    ExperimentProtocolVersion[]
  protocolRuns       ProtocolRun[]
  results            Result[]

  @@unique([protocolId, revision])
  @@index([protocolId])
  @@index([reviewStage])
  @@index([recordStatus])
  @@index([sourceType])
  @@index([previousVersionId])
  @@index([derivedFromVersionId])
}

model ProtocolRun {
  id                        String           @id @default(cuid())
  protocolVersionId         String
  protocolVersion           ProtocolVersion  @relation(fields: [protocolVersionId], references: [id], onDelete: Restrict)
  experimentId              String           @unique
  experiment                Experiment       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  parametersJson            Json             @default("{}")
  calculatedConsumptionJson Json             @default("[]")
  status                    ExperimentStatus @default(planned)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([protocolVersionId])
}

model ExperimentStep {
  id              String     @id @default(cuid())
  experimentId    String
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  protocolStepRef String?
  groupKey        String     @default("manual")
  groupTitle      String     @default("Custom experiment steps")
  groupOrder      Int        @default(0)
  order           Int
  title           String
  description     String
  completed       Boolean    @default(false)
  completedAt     DateTime?
  deviationNote   String?

  @@index([experimentId, groupOrder, order])
}

model Entity {
  id             String       @id @default(cuid())
  name           String
  type           EntityType   @default(other)
  code           String?
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         ObjectStatus @default(active)
  description    String?
  metadataJson   Json         @default("{}")
  parentEntityId String?
  parentEntity   Entity?      @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities  Entity[]     @relation("EntityHierarchy")
  sequenceId     String?
  sequence       Sequence?    @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems InventoryItem[]
  sequenceLinks  EntitySequenceLink[]
  results        Result[]
  sampleProfile  SampleProfile?

  @@index([type])
  @@index([status])
  @@index([projectId])
  @@index([sequenceId])
}

model InventoryLocation {
  id               String                @id @default(cuid())
  name             String
  type             InventoryLocationType @default(other)
  status           ObjectStatus          @default(active)
  parentLocationId String?
  parentLocation   InventoryLocation?    @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations   InventoryLocation[]   @relation("LocationHierarchy")
  temperature      String?
  description      String?

  itemsFrom        InventoryTransaction[] @relation("FromLocation")
  itemsTo          InventoryTransaction[] @relation("ToLocation")
  items            InventoryItem[]
  sampleEventsFrom SampleLifecycleEvent[] @relation("SampleEventFromLocation")
  sampleEventsTo   SampleLifecycleEvent[] @relation("SampleEventToLocation")

  @@index([type])
  @@index([status])
  @@index([parentLocationId])
}

model InventoryItem {
  id                    String             @id @default(cuid())
  entityId              String?
  entity                Entity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  name                  String
  englishName           String?
  category              String?
  brand                 String?
  principalInvestigator String?
  containerType         String?
  barcode               String?
  aliquotCode           String?
  lotNumber             String?
  vendor                String?
  catalogNumber         String?
  casNumber             String?
  currentQuantity       Float              @default(0)
  unit                  String
  lowThreshold          Float?
  concentration         String?
  locationId            String?
  location              InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  positionCode          String?
  parentInventoryItemId String?
  parentInventoryItem   InventoryItem?     @relation("InventoryAliquots", fields: [parentInventoryItemId], references: [id], onDelete: SetNull)
  childInventoryItems   InventoryItem[]    @relation("InventoryAliquots")
  expiryDate            DateTime?
  storageCondition      String?
  freezeThawCount       Int                @default(0)
  status                ObjectStatus       @default(active)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  transactions InventoryTransaction[]
  purchases    PurchaseRequest[]
  sampleEvents SampleLifecycleEvent[]

  @@unique([aliquotCode])
  @@index([entityId])
  @@index([category])
  @@index([principalInvestigator])
  @@index([locationId])
  @@index([parentInventoryItemId])
  @@index([expiryDate])
  @@index([status])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  inventoryItemId  String
  inventoryItem    InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type             InventoryTransactionType
  quantityChange   Float
  unit             String
  fromLocationId   String?
  fromLocation     InventoryLocation?       @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId     String?
  toLocation       InventoryLocation?       @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  experimentId     String?
  experiment       Experiment?              @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  purchaseId       String?
  purchase         PurchaseRequest?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  proposedActionId String?
  proposedAction   ProposedAction?          @relation(fields: [proposedActionId], references: [id], onDelete: SetNull)
  performedBy      String?
  notes            String?
  createdAt        DateTime                 @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([experimentId])
  @@index([purchaseId])
}

model SampleProfile {
  id                 String                @id @default(cuid())
  entityId           String                @unique
  entity             Entity                @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sampleCode         String                @unique
  sampleType         String
  sourceLabel        String?
  sourceType         String?
  parentSampleId     String?
  parentSample       SampleProfile?        @relation("SampleLineage", fields: [parentSampleId], references: [id], onDelete: SetNull)
  childSamples       SampleProfile[]       @relation("SampleLineage")
  collectedAt        DateTime?
  preparedAt         DateTime?
  status             SampleLifecycleStatus @default(registered)
  biosafetyLevel     String?
  storageRequirement String?
  freezeThawCount    Int                   @default(0)
  notes              String?
  metadataJson       Json                  @default("{}")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  events SampleLifecycleEvent[]

  @@index([sampleType])
  @@index([status])
  @@index([parentSampleId])
}

model SampleLifecycleEvent {
  id              String                   @id @default(cuid())
  sampleProfileId String
  sampleProfile   SampleProfile            @relation(fields: [sampleProfileId], references: [id], onDelete: Cascade)
  type            SampleLifecycleEventType
  title           String
  occurredAt      DateTime                 @default(now())
  experimentId    String?
  experiment      Experiment?              @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  inventoryItemId String?
  inventoryItem   InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  fromLocationId  String?
  fromLocation    InventoryLocation?       @relation("SampleEventFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId    String?
  toLocation      InventoryLocation?       @relation("SampleEventToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  quantityChange  Float?
  unit            String?
  notes           String?
  metadataJson    Json                     @default("{}")
  createdAt       DateTime                 @default(now())

  @@index([sampleProfileId])
  @@index([type])
  @@index([occurredAt])
  @@index([experimentId])
  @@index([inventoryItemId])
}

model Result {
  id                    String                 @id @default(cuid())
  experimentId          String?
  experiment            Experiment?            @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  researchPlanId        String?
  researchPlan          ResearchPlan?          @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  entityId              String?
  entity                Entity?                @relation(fields: [entityId], references: [id], onDelete: SetNull)
  projectId             String?
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  resultType            String
  title                 String
  textValue             String?
  numericValue          Float?
  unit                  String?
  status                ObjectStatus           @default(active)
  recordStatus          RecordLifecycleStatus  @default(draft)
  sourceType            ResultSourceType       @default(manual)
  qualityStatus         ResultQualityStatus    @default(not_assessed)
  validationStatus      ResultValidationStatus @default(not_applicable)
  analysisMethod        String?
  protocolVersionId     String?
  protocolVersion       ProtocolVersion?       @relation(fields: [protocolVersionId], references: [id], onDelete: SetNull)
  templateKey           String?
  templateInstanceKey   String?
  templateInstanceLabel String?
  templateSnapshotJson  Json                   @default("{}")
  valuesJson            Json                   @default("{}")
  validationJson        Json                   @default("{}")
  viewSpecJson          Json                   @default("{}")
  contentJson           Json                   @default("{}")
  provenanceJson        Json                   @default("{}")
  metadataJson          Json                   @default("{}")
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  datasets      ResultDataset[]
  reportSources ReportSource[]

  @@index([experimentId])
  @@index([entityId])
  @@index([projectId])
  @@index([researchPlanId])
  @@index([resultType])
  @@index([recordStatus])
  @@index([sourceType])
  @@index([qualityStatus])
  @@index([validationStatus])
  @@index([protocolVersionId])
  @@index([templateKey])
  @@index([experimentId, templateKey, templateInstanceKey])
}

/// User-maintained point-and-click vocabulary for manual Result records.
/// Result.resultType remains a text snapshot so renaming or deleting an option
/// never rewrites historical evidence.
model ResultTypeDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder, label])
}

model ScientificSchemaDefinition {
  id               String     @id @default(cuid())
  key              String     @unique
  label            String
  entityType       EntityType
  objectKind       String     @default("entity")
  prefix           String?
  fieldDefinitions Json       @default("[]")
  defaultSettings  Json       @default("{}")
  enabled          Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([enabled, label])
  @@index([entityType])
}

model ResultDataset {
  id                 String                   @id @default(cuid())
  resultId           String
  result             Result                   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  name               String
  storageMode        ResultDatasetStorageMode @default(managed_file)
  sourceFileName     String?
  mimeType           String?
  size               Int?
  storagePath        String?
  externalUri        String?
  checksum           String?
  rowCount           Int                      @default(0)
  columnCount        Int                      @default(0)
  columnsJson        Json                     @default("[]")
  previewJson        Json                     @default("[]")
  templateDatasetKey String?
  schemaJson         Json                     @default("{}")
  validationStatus   ResultValidationStatus   @default(not_applicable)
  validationJson     Json                     @default("{}")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([resultId])
  @@index([storageMode])
  @@index([templateDatasetKey])
  @@index([validationStatus])
}

model Report {
  id                 String        @id @default(cuid())
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  researchPlanId     String?
  researchPlan       ResearchPlan? @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  title              String
  status             ReportStatus  @default(draft)
  periodStart        DateTime?
  periodEnd          DateTime?
  contentJson        Json          @default("{}")
  sourceSnapshotJson Json          @default("{}")
  tags               String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sources ReportSource[]

  @@index([projectId])
  @@index([researchPlanId])
  @@index([status])
  @@index([updatedAt])
}

model ReportSource {
  id              String   @id @default(cuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceType      String
  sourceId        String
  titleSnapshot   String
  versionSnapshot String?
  hrefSnapshot    String?
  metadataJson    Json     @default("{}")
  order           Int      @default(0)
  includedAt      DateTime @default(now())
  resultId        String?
  result          Result?  @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@unique([reportId, sourceType, sourceId])
  @@index([reportId, order])
  @@index([sourceType, sourceId])
  @@index([resultId])
}

model PurchaseRequest {
  id                     String                @id @default(cuid())
  title                  String
  status                 PurchaseStatus        @default(planned)
  vendor                 String?
  catalogNumber          String?
  quantity               Float
  unit                   String
  price                  Float?
  orderDate              DateTime?
  receivedDate           DateTime?
  lotNumber              String?
  expiryDate             DateTime?
  storageCondition       String?
  linkedInventoryItemId  String?
  linkedInventoryItem    InventoryItem?        @relation(fields: [linkedInventoryItemId], references: [id], onDelete: SetNull)
  procurementQuoteLineId String?               @unique
  procurementQuoteLine   ProcurementQuoteLine? @relation(fields: [procurementQuoteLineId], references: [id], onDelete: SetNull)
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  transactions InventoryTransaction[]

  @@index([status])
  @@index([linkedInventoryItemId])
}

model ProcurementInquiry {
  id               String                   @id @default(cuid())
  title            String
  status           ProcurementInquiryStatus @default(draft)
  sourceType       ProcurementSourceType    @default(excel)
  projectId        String?
  project          Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  importedFileName String?
  supplierScope    String?
  quotedAt         DateTime?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  quoteLines ProcurementQuoteLine[]

  @@index([status])
  @@index([sourceType])
  @@index([projectId])
  @@index([quotedAt])
}

model ProcurementQuoteLine {
  id                  String                     @id @default(cuid())
  inquiryId           String
  inquiry             ProcurementInquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status              ProcurementQuoteLineStatus @default(candidate)
  supplierName        String?
  productCategory     String?
  productName         String
  casNumber           String?
  specification       String?
  quantity            Float
  packageUnit         String
  amountExclTax       Float?
  taxAmount           Float?
  unitPriceExclTax    Float?
  specialPurchaseNote String?
  capacity            Float?
  capacityUnit        String?
  brand               String?
  catalogNumber       String?
  taxRate             Float?
  amountInclTax       Float?
  decisionReason      String?
  selectedAt          DateTime?
  metadataJson        Json                       @default("{}")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  purchaseRequest PurchaseRequest?

  @@index([inquiryId])
  @@index([status])
  @@index([supplierName])
  @@index([productCategory])
}

model Attachment {
  id               String       @id @default(cuid())
  filename         String
  originalFilename String
  mimeType         String
  size             Int
  storagePath      String
  sha256           String?
  metadataJson     Json         @default("{}")
  derivedFromId    String?
  derivedFrom      Attachment?  @relation("AttachmentDerivatives", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives      Attachment[] @relation("AttachmentDerivatives")
  derivativeKind   String?
  uploadedAt       DateTime     @default(now())

  links AttachmentLink[]

  @@index([sha256])
  @@index([derivedFromId])
}

model AttachmentLink {
  id           String     @id @default(cuid())
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  linkType     String     @default("attached_to")
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([attachmentId])
  @@index([targetType, targetId])
}

model Sequence {
  id             String                  @id @default(cuid())
  code           String                  @unique
  name           String
  entryClass     SequenceEntryClass      @default(nucleic_acid)
  ownershipScope SequenceOwnershipScope  @default(library)
  designType     SequenceDesignType      @default(other)
  status         SequenceLifecycleStatus @default(draft)
  description    String?
  projectId      String?
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  targetName     String?
  organism       String?
  metadataJson   Json                    @default("{}")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  entities       Entity[]
  versions       SequenceVersion[]
  entityLinks    EntitySequenceLink[]
  pairMembership SequencePairMember?

  @@index([entryClass])
  @@index([ownershipScope])
  @@index([designType])
  @@index([status])
  @@index([projectId])
  @@index([targetName])
}

model SequenceVersion {
  id                String                   @id @default(cuid())
  sequenceId        String
  sequenceRecord    Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  versionNumber     Int
  displayVersion    String                   @default("1.0")
  moleculeType      SequenceType
  sequence          String
  checksum          String
  topology          SequenceTopology         @default(linear)
  strandedness      SequenceStrandedness     @default(unknown)
  orientation       String                   @default("5to3")
  validationStatus  SequenceValidationStatus @default(unverified)
  validationSummary String?
  validatedAt       DateTime?
  changeSummary     String?
  sourceType        SequenceSourceType       @default(manual)
  sourceFileName    String?
  createdAt         DateTime                 @default(now())

  features          SequenceFeature[]
  modifications     SequenceModification[]
  entityLinks       EntitySequenceLink[]
  collectionMembers SequenceCollectionMember[]
  pairMembership    SequencePairMember?
  workflowInputs    SequenceWorkflowInput[]

  @@unique([sequenceId, versionNumber])
  @@index([sequenceId, checksum])
  @@index([moleculeType])
  @@index([validationStatus])
  @@index([checksum])
}

model SequencePairMember {
  id                String           @id @default(cuid())
  pairId            String
  pair              SequencePair     @relation(fields: [pairId], references: [id], onDelete: Cascade)
  sequenceId        String           @unique
  sequenceRecord    Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  sequenceVersionId String           @unique
  sequenceVersion   SequenceVersion  @relation(fields: [sequenceVersionId], references: [id], onDelete: Restrict)
  role              SequencePairRole
  order             Int              @default(0)
  note              String?

  @@unique([pairId, role])
  @@unique([pairId, sequenceId])
  @@index([pairId, order])
}

model SequencePair {
  id             String                  @id @default(cuid())
  code           String                  @unique
  name           String
  type           SequencePairType
  status         SequenceLifecycleStatus @default(draft)
  description    String?
  ownershipScope SequenceOwnershipScope  @default(library)
  projectId      String?
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  targetName     String?
  organism       String?
  metadataJson   Json                    @default("{}")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  members     SequencePairMember[]
  collections SequenceCollectionPairMember[]

  @@index([type])
  @@index([status])
  @@index([ownershipScope])
  @@index([projectId])
  @@index([targetName])
}

model SequenceWorkflow {
  id           String                  @id @default(cuid())
  code         String                  @unique
  type         SequenceWorkflowType
  name         String
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status       SequenceLifecycleStatus @default(draft)
  method       String
  reference    String?
  pam          String?
  description  String?
  metadataJson Json                    @default("{}")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  inputs SequenceWorkflowInput[]

  @@index([type])
  @@index([projectId])
  @@index([status])
}

model SequenceWorkflowInput {
  id                String           @id @default(cuid())
  workflowId        String
  workflow          SequenceWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sequenceVersionId String
  sequenceVersion   SequenceVersion  @relation(fields: [sequenceVersionId], references: [id], onDelete: Restrict)
  role              String           @default("input")
  order             Int              @default(0)

  @@unique([workflowId, sequenceVersionId, role])
  @@index([workflowId, order])
  @@index([sequenceVersionId])
}

model SequenceFeature {
  id                String          @id @default(cuid())
  sequenceVersionId String
  sequenceVersion   SequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Cascade)
  name              String
  type              String
  start             Int
  end               Int
  strand            String?
  note              String?

  @@index([sequenceVersionId])
}

model SequenceModification {
  id                String          @id @default(cuid())
  sequenceVersionId String
  sequenceVersion   SequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Cascade)
  position          String
  modification      String
  note              String?
  order             Int             @default(0)

  @@index([sequenceVersionId, order])
}

model EntitySequenceLink {
  id                String          @id @default(cuid())
  entityId          String
  entity            Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sequenceId        String
  sequenceRecord    Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceVersionId String
  sequenceVersion   SequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Restrict)
  role              String          @default("primary")
  isPrimary         Boolean         @default(false)
  order             Int             @default(0)
  note              String?
  createdAt         DateTime        @default(now())

  @@unique([entityId, sequenceVersionId, role])
  @@index([entityId, order])
  @@index([sequenceId])
  @@index([sequenceVersionId])
}

model SequenceCollection {
  id             String                  @id @default(cuid())
  code           String                  @unique
  name           String
  type           SequenceCollectionType
  status         SequenceLifecycleStatus @default(draft)
  description    String?
  ownershipScope SequenceOwnershipScope  @default(library)
  projectId      String?
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  metadataJson   Json                    @default("{}")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  members     SequenceCollectionMember[]
  pairMembers SequenceCollectionPairMember[]

  @@index([type])
  @@index([status])
  @@index([ownershipScope])
  @@index([projectId])
}

model SequenceCollectionMember {
  id                String             @id @default(cuid())
  collectionId      String
  collection        SequenceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sequenceVersionId String
  sequenceVersion   SequenceVersion    @relation(fields: [sequenceVersionId], references: [id], onDelete: Restrict)
  role              String             @default("member")
  order             Int                @default(0)
  note              String?

  @@unique([collectionId, sequenceVersionId, role])
  @@index([collectionId, order])
  @@index([sequenceVersionId])
}

model SequenceCollectionPairMember {
  id           String             @id @default(cuid())
  collectionId String
  collection   SequenceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  pairId       String
  pair         SequencePair       @relation(fields: [pairId], references: [id], onDelete: Restrict)
  role         String             @default("member")
  order        Int                @default(0)
  note         String?

  @@unique([collectionId, pairId, role])
  @@index([collectionId, order])
  @@index([pairId])
}

model ItemLink {
  id         String        @id @default(cuid())
  sourceType String
  sourceId   String
  targetType String
  targetId   String
  linkType   String
  createdBy  LinkCreatedBy @default(user)
  confidence Float?
  note       String?
  createdAt  DateTime      @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model ProposedAction {
  id          String                   @id @default(cuid())
  sourceType  ProposedActionSourceType
  sourceId    String?
  actionType  ProposedActionType
  status      ProposedActionStatus     @default(pending)
  confidence  Float?
  reason      String?
  payloadJson Json                     @default("{}")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  executedAt  DateTime?

  inventoryTransactions InventoryTransaction[]

  @@index([status])
  @@index([sourceType, sourceId])
  @@index([actionType])
}

model AIProvider {
  id               String         @id @default(cuid())
  name             String
  type             AIProviderType
  baseUrl          String?
  apiKeyEncrypted  String?
  defaultModel     String?
  capabilitiesJson Json           @default("[]")
  enabled          Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  aisettings       AISettings[]

  @@index([type])
  @@index([enabled])
}

model AISettings {
  id                 String      @id @default("default")
  enabled            Boolean     @default(false)
  defaultProviderId  String?
  defaultProvider    AIProvider? @relation(fields: [defaultProviderId], references: [id], onDelete: SetNull)
  externalDataPolicy String      @default("explicit_context")
  attachmentsEnabled Boolean     @default(false)
  updatedAt          DateTime    @updatedAt

  @@index([defaultProviderId])
}

model ReferenceConnector {
  id           String                @id @default(cuid())
  provider     ReferenceProviderType
  displayName  String
  libraryScope String?
  baseUrl      String?
  enabled      Boolean               @default(false)
  lastSyncedAt DateTime?
  notes        String?
  metadataJson Json                  @default("{}")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([provider])
  @@index([enabled])
}

model ActivityLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  targetType   String
  targetId     String
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model DeletedRecord {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String
  identifier   String
  title        String
  snapshotJson Json
  deletedAt    DateTime  @default(now())
  restoredAt   DateTime?

  @@index([restoredAt, deletedAt])
  @@index([targetType, targetId])
}
