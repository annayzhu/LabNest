// LabNest V1 schema.
// Prisma 7 keeps the datasource URL in prisma.config.ts; this schema remains
// provider-focused and is designed for local PostgreSQL via Docker Compose.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntrySourceType {
  text
  photo
  file
  voice
  manual
}

enum RecordLifecycleStatus {
  draft
  recorded
  submitted
  reviewed
}

enum ExperimentStatus {
  planned
  running
  completed
  failed
  archived
}

enum ResearchPlanStatus {
  draft
  active
  paused
  completed
  archived
}

enum ResultSourceType {
  manual
  protocol_template
  file_import
  tool
  analysis
}

enum ResultQualityStatus {
  not_assessed
  pass
  warning
  fail
}

enum ResultValidationStatus {
  not_applicable
  incomplete
  valid
  warning
  invalid
}

enum ResultDatasetStorageMode {
  managed_file
  external_reference
}

enum ReportStatus {
  draft
  ready_for_review
  final
  archived
}

enum ProtocolAvailability {
  draft
  active
  retired
  archived

  @@map("ProtocolStatus")
}

enum ProtocolReviewStage {
  draft
  ready_for_review
  reviewed
}

enum ProtocolScope {
  general
  project
}

enum ProtocolVersionSourceType {
  manual
  docx_import
  derived
  ai_design
  /// Laid out by the AI from a manual or a free-form Protocol, checked line by line against it (AI 识别).
  ai_recognized
}

enum ExperimentProtocolRole {
  primary
  supporting
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum EntityType {
  plasmid
  primer
  oligo
  cell_line
  antibody
  protein
  reagent
  compound
  bacteria
  mixture
  sample
  other
}

enum ObjectStatus {
  active
  inactive
  archived
}

/// Only a sample in storage holds a box position; the others free it.
enum SampleStatus {
  available
  depleted
  discarded
  sent_out
}

enum ExperimentSampleRole {
  input
  output
}

enum InventoryLocationType {
  freezer
  fridge
  shelf
  box
  position
  drawer
  plate
  rack
  room
  other
}

enum InventoryTransactionType {
  add
  consume
  transfer
  adjust
  discard
  receive
  aliquot
  thaw
  refreeze
  qc
  return
}

enum PurchaseStatus {
  planned
  ordered
  received
  stocked
  cancelled
}

enum ProcurementInquiryStatus {
  draft
  quoted
  selected
  converted
  archived
}

enum ProcurementQuoteLineStatus {
  candidate
  selected
  not_selected
  expired
  rejected
  duplicate
  future_candidate
  converted
}

enum ProcurementSourceType {
  excel
  manual
  school_template
}

enum SequenceType {
  DNA
  RNA
  Protein
}

enum SequenceOwnershipScope {
  library
  project
}

enum SequenceEntryClass {
  nucleic_acid
  amino_acid
  oligo
}

enum SequencePairType {
  primer_pair
  sirna_duplex
}

enum SequencePairRole {
  forward
  reverse
  sense
  antisense
}

enum SequenceWorkflowType {
  alignment
  assembly
  crispr
}

enum SequenceDesignType {
  plasmid
  primer
  probe
  siRNA
  shRNA
  gRNA
  oligo
  peptide
  protein
  fragment
  other
}

enum SequenceLifecycleStatus {
  draft
  active
  inactive
  archived
}

enum SequenceValidationStatus {
  unverified
  validation_in_progress
  validated_recommended
  validated_limited
  validated_not_recommended
  inconclusive
}

enum SequenceTopology {
  linear
  circular
}

enum SequenceStrandedness {
  single
  double
  unknown
}

enum SequenceSourceType {
  manual
  fasta_import
  csv_import
  xlsx_import
}

enum SequenceCollectionType {
  primer_pair
  sirna_duplex
  primer_panel
  sirna_series
  sequence_series
  shrna_construct
  probe_panel
  plasmid_construct
  peptide_set
  other
}

enum LinkCreatedBy {
  user
  system
  ai
}

enum ProposedActionSourceType {
  ai
  protocol
  entry
  import
  manual
  system
}

enum ProposedActionStatus {
  pending
  accepted
  rejected
  edited
  executed
}

enum ProposedActionType {
  create_experiment
  update_experiment
  consume_inventory
  create_entity
  create_result
  create_purchase_request
  receive_purchase
  link_attachment
  link_item
  create_inventory_item
  create_protocol_run
}

enum AIProviderType {
  openai
  anthropic
  openai_compatible
  dify
  manual_copy_paste
  chatgpt_subscription
}

enum ReferenceProviderType {
  zotero
  endnote
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  keyInformation String?
  status         ProjectStatus @default(active)
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entries              Entry[]
  researchPlans        ResearchPlan[]
  experiments          Experiment[]
  protocols            Protocol[]
  protocolAssociations ProjectProtocol[]
  entities             Entity[]
  sequences            Sequence[]
  sequencePairs        SequencePair[]
  sequenceCollections  SequenceCollection[]
  sequenceWorkflows    SequenceWorkflow[]
  results              Result[]
  reports              Report[]
  procurementInquiries ProcurementInquiry[]
  samples              Sample[]

  @@index([status])
  @@index([createdAt])
}

model ResearchPlan {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  code           String             @unique
  title          String
  objective      String?
  hypothesis     String?
  rationale      String?
  keyInformation String?
  design         String?
  contentJson    Json               @default("{}")
  status         ResearchPlanStatus @default(draft)
  tags           String[]           @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  entries     Entry[]
  experiments Experiment[]
  protocols   ResearchPlanProtocol[]
  results     Result[]
  reports     Report[]
  copilotRuns ResearchPlanCopilotRun[]
  designRuns  ResearchPlanDesignRun[]

  @@index([projectId])
  @@index([status])
}

model ResearchPlanProtocol {
  researchPlanId String
  researchPlan   ResearchPlan @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  protocolId     String
  protocol       Protocol     @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())

  @@id([researchPlanId, protocolId])
  @@index([protocolId])
}

model Entry {
  entryType          String                @default("unclassified")
  eventTimePrecision String                @default("unknown")
  id                 String                @id @default(cuid())
  title              String
  body               String
  occurredAt         DateTime              @default(now())
  projectId          String?
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  researchPlanId     String?
  researchPlan       ResearchPlan?         @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  experimentId       String?
  experiment         Experiment?           @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  experimentStepId   String?
  experimentStep     ExperimentStep?       @relation(fields: [experimentStepId], references: [id], onDelete: SetNull)
  tags               String[]              @default([])
  moodStatus         String?
  sourceType         EntrySourceType       @default(text)
  recordStatus       RecordLifecycleStatus @default(draft)
  contentJson        Json                  @default("{}")
  archivedAt         DateTime?
  clientMutationId   String?               @unique
  deviceCreatedAt    DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([recordStatus])
  @@index([occurredAt])
  @@index([projectId])
  @@index([researchPlanId])
  @@index([experimentId])
  @@index([experimentStepId])
  @@index([archivedAt])
}

model Experiment {
  materialUses             RunMaterialUse[]
  inventoryObservations    InventoryObservation[]
  id                       String                 @id @default(cuid())
  runCode                  String                 @unique
  creationKey              String?                @unique
  title                    String
  projectId                String?
  project                  Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  researchPlanId           String?
  researchPlan             ResearchPlan?          @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  status                   ExperimentStatus       @default(planned)
  recordStatus             RecordLifecycleStatus  @default(draft)
  date                     DateTime               @default(now())
  purpose                  String?
  contentJson              Json                   @default("{}")
  /// Derived plain-text mirror of purpose + contentJson. Written on every save,
  /// never edited directly; exists only so search does not need per-section columns.
  searchText               String?
  protocolSnapshotJson     Json                   @default("{}")
  primaryProtocolVersionId String?                @map("protocolVersionId")
  primaryProtocolVersion   ProtocolVersion?       @relation("PrimaryExperimentProtocol", fields: [primaryProtocolVersionId], references: [id], onDelete: SetNull)
  tags                     String[]               @default([])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  protocolRun           ProtocolRun?
  steps                 ExperimentStep[]
  inventoryTransactions InventoryTransaction[]
  samples               ExperimentSample[]
  sampleGroups          ExperimentSampleGroup[]
  results               Result[]
  entries               Entry[]
  protocolVersions      ExperimentProtocolVersion[]
  scheduleBlocks        ExperimentScheduleBlock[]
  /// How many days the schedule spans from `date`, as the author set it; null follows the blocks. Never shorter than they reach.
  scheduleDays          Int?

  @@index([status])
  @@index([recordStatus])
  @@index([date])
  @@index([projectId])
  @@index([researchPlanId])
  @@index([primaryProtocolVersionId])
}

/// 日程段 (Q259–Q270): one day's stretch of an experiment's steps, or an item that is not in a Protocol (复苏细胞、送测序…).
/// The first block's day is the experiment's `date`; an experiment without blocks is one block on that day.
model ExperimentScheduleBlock {
  id               String     @id @default(cuid())
  experimentId     String
  experiment       Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  /// steps | task
  kind             String     @default("steps")
  /// Empty: shown as "<Protocol> · steps a–b".
  title            String?
  /// The steps it covers by their stable reference (`protocolStepRef`, or the step id of a custom step); group copies follow.
  stepRefs         String[]   @default([])
  startAt          DateTime
  allDay           Boolean    @default(false)
  estimatedMinutes Int?
  /// The block it waits for, and how long after that block ends it may start. Null bounds are open.
  afterBlockId     String?
  minGapMinutes    Int?
  maxGapMinutes    Int?
  /// Where the gap came from: "step:<ref>", "overnight:<ref>" or "manual".
  gapSource        String?
  note             String?
  /// Items only: ticked off.
  doneAt           DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([experimentId, startAt])
  @@index([startAt])
}

model ExperimentProtocolVersion {
  experimentId      String
  experiment        Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  protocolVersionId String
  protocolVersion   ProtocolVersion        @relation(fields: [protocolVersionId], references: [id], onDelete: Restrict)
  role              ExperimentProtocolRole @default(supporting)
  order             Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@id([experimentId, protocolVersionId])
  @@index([protocolVersionId])
  @@index([experimentId, order])
}

model Protocol {
  id             String                @id @default(cuid())
  humanCode      String                @unique
  title          String
  canonicalTitle String?
  shortTitle     String?
  englishTitle   String?
  description    String?
  scope          ProtocolScope         @default(general)
  availability   ProtocolAvailability  @default(draft) @map("status")
  recordStatus   RecordLifecycleStatus @default(draft)
  projectId      String?
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags           String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  versions            ProtocolVersion[]
  researchPlans       ResearchPlanProtocol[]
  projectAssociations ProjectProtocol[]

  @@index([availability])
  @@index([scope])
  @@index([recordStatus])
  @@index([projectId])
}

/// Reusable library Protocols may be associated with several Projects without
/// changing their ownership/context (`Protocol.projectId`).
model ProjectProtocol {
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  protocolId String
  protocol   Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, protocolId])
  @@index([protocolId])
}

model RecordCodeCounter {
  key       String   @id
  value     BigInt
  updatedAt DateTime @updatedAt
}

model ProtocolVersion {
  id                   String                    @id @default(cuid())
  protocolId           String
  protocol             Protocol                  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  revision             Int                       @map("versionNumber")
  displayVersion       String                    @default("0.1")
  reviewStage          ProtocolReviewStage       @default(draft)
  recordStatus         RecordLifecycleStatus     @default(draft)
  previousVersionId    String?
  previousVersion      ProtocolVersion?          @relation("ProtocolRevisionHistory", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions         ProtocolVersion[]         @relation("ProtocolRevisionHistory")
  derivedFromVersionId String?
  derivedFromVersion   ProtocolVersion?          @relation("ProtocolDerivation", fields: [derivedFromVersionId], references: [id], onDelete: SetNull)
  derivedVersions      ProtocolVersion[]         @relation("ProtocolDerivation")
  adaptationRationale  String?
  changeSummary        String?
  sourceType           ProtocolVersionSourceType @default(manual)
  sourceFileName       String?
  sourceFileChecksum   String?
  sourceImportedAt     DateTime?
  title                String
  purpose              String?
  background           String?
  scope                String?
  notes                String?
  parametersJson       Json                      @default("[]")
  materialsJson        Json                      @default("[]")
  equipmentJson        Json                      @default("[]")
  stepsJson            Json                      @default("[]")
  consumptionRulesJson Json                      @default("[]")
  resultTemplatesJson  Json                      @default("[]")
  contentJson          Json                      @default("{}")
  createdAt            DateTime                  @default(now())

  primaryExperiments Experiment[]                @relation("PrimaryExperimentProtocol")
  experimentLinks    ExperimentProtocolVersion[]
  protocolRuns       ProtocolRun[]
  results            Result[]

  @@unique([protocolId, revision])
  @@index([protocolId])
  @@index([reviewStage])
  @@index([recordStatus])
  @@index([sourceType])
  @@index([previousVersionId])
  @@index([derivedFromVersionId])
}

model ProtocolRun {
  id                        String           @id @default(cuid())
  protocolVersionId         String
  protocolVersion           ProtocolVersion  @relation(fields: [protocolVersionId], references: [id], onDelete: Restrict)
  experimentId              String           @unique
  experiment                Experiment       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  parametersJson            Json             @default("{}")
  calculatedConsumptionJson Json             @default("[]")
  executionPlanJson         Json             @default("{}")
  status                    ExperimentStatus @default(planned)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([protocolVersionId])
}

model ExperimentStep {
  id                    String                 @id @default(cuid())
  experimentId          String
  experiment            Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  protocolStepRef       String?
  groupKey              String                 @default("manual")
  groupTitle            String                 @default("Custom experiment steps")
  groupOrder            Int                    @default(0)
  order                 Int
  title                 String
  description           String
  requiresConfirmation  Boolean                @default(true)
  allowsDeviation       Boolean                @default(true)
  completed             Boolean                @default(false)
  completedAt           DateTime?
  deviationNote         String?
  deviationType         String?
  deviationImpact       String?
  deviationAuthor       String?
  deviationAt           DateTime?
  timerDurationSeconds  Int?
  timerRemainingSeconds Int?
  timerStartedAt        DateTime?
  timerPausedAt         DateTime?
  inventoryTransactions InventoryTransaction[]
  events                ExperimentStepEvent[]
  results               Result[]
  entries               Entry[]

  @@index([experimentId, groupOrder, order])
}

model ExperimentStepEvent {
  id               String         @id @default(cuid())
  experimentStepId String
  experimentStep   ExperimentStep @relation(fields: [experimentStepId], references: [id], onDelete: Cascade)
  experimentId     String
  eventType        String
  clientMutationId String?        @unique
  deviceCreatedAt  DateTime?
  payloadJson      Json           @default("{}")
  createdAt        DateTime       @default(now())

  @@index([experimentStepId, createdAt])
  @@index([experimentId, createdAt])
}

model Entity {
  id             String       @id @default(cuid())
  name           String
  type           EntityType   @default(other)
  code           String?
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         ObjectStatus @default(active)
  description    String?
  metadataJson   Json         @default("{}")
  parentEntityId String?
  parentEntity   Entity?      @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities  Entity[]     @relation("EntityHierarchy")
  sequenceId     String?
  sequence       Sequence?    @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems    InventoryItem[]
  inventoryProducts InventoryProduct[]
  sequenceLinks     EntitySequenceLink[]
  results           Result[]

  @@index([type])
  @@index([status])
  @@index([projectId])
  @@index([sequenceId])
}

model InventoryLocation {
  id               String                @id @default(cuid())
  name             String
  type             InventoryLocationType @default(other)
  status           ObjectStatus          @default(active)
  parentLocationId String?
  parentLocation   InventoryLocation?    @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations   InventoryLocation[]   @relation("LocationHierarchy")
  temperature      String?
  description      String?
  /// A box or plate's rows and columns (9 × 9, 8 × 12…); samples then sit at A1-style positions inside it.
  gridRows         Int?
  gridColumns      Int?

  itemsFrom InventoryTransaction[] @relation("FromLocation")
  itemsTo   InventoryTransaction[] @relation("ToLocation")
  items     InventoryItem[]
  samples   Sample[]

  @@index([type])
  @@index([status])
  @@index([parentLocationId])
}

model InventoryItem {
  id                    String             @id @default(cuid())
  /// The product this stock is a lot of; name, English name, brand, catalogue and CAS are written from it.
  productId             String?
  product               InventoryProduct?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  entityId              String?
  entity                Entity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  name                  String
  englishName           String?
  category              String?
  brand                 String?
  principalInvestigator String?
  containerType         String?
  barcode               String?
  aliquotCode           String?
  lotNumber             String?
  vendor                String?
  catalogNumber         String?
  casNumber             String?
  currentQuantity       Float              @default(0)
  managementMode        String             @default("precise")
  quantityRecorded      Boolean            @default(true)
  unit                  String
  lowThreshold          Float?
  concentration         String?
  locationId            String?
  location              InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  positionCode          String?
  parentInventoryItemId String?
  parentInventoryItem   InventoryItem?     @relation("InventoryAliquots", fields: [parentInventoryItemId], references: [id], onDelete: SetNull)
  childInventoryItems   InventoryItem[]    @relation("InventoryAliquots")
  expiryDate            DateTime?
  storageCondition      String?
  freezeThawCount       Int                @default(0)
  status                ObjectStatus       @default(active)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  materialUses RunMaterialUse[]
  receipts     PurchaseReceipt[]
  containers   InventoryContainer[]
  transactions InventoryTransaction[]
  purchases    PurchaseRequest[]

  @@unique([aliquotCode])
  @@index([productId])
  @@index([entityId])
  @@index([category])
  @@index([principalInvestigator])
  @@index([locationId])
  @@index([parentInventoryItemId])
  @@index([expiryDate])
  @@index([status])
}

model InventoryTransaction {
  materialUse           RunMaterialUse?
  id                    String                   @id @default(cuid())
  inventoryItemId       String
  inventoryItem         InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type                  InventoryTransactionType
  quantityChange        Float
  unit                  String
  fromLocationId        String?
  fromLocation          InventoryLocation?       @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId          String?
  toLocation            InventoryLocation?       @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  experimentId          String?
  experiment            Experiment?              @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  experimentStepId      String?
  experimentStep        ExperimentStep?          @relation(fields: [experimentStepId], references: [id], onDelete: SetNull)
  purchaseId            String?
  purchase              PurchaseRequest?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  proposedActionId      String?
  proposedAction        ProposedAction?          @relation(fields: [proposedActionId], references: [id], onDelete: SetNull)
  performedBy           String?
  notes                 String?
  clientMutationId      String?                  @unique
  deviceCreatedAt       DateTime?
  /// A reversal points at the movement it undoes; the original stays as recorded.
  reversesTransactionId String?                  @unique
  reverses              InventoryTransaction?    @relation("TransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy            InventoryTransaction?    @relation("TransactionReversal")
  createdAt             DateTime                 @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([experimentId])
  @@index([experimentStepId])
  @@index([purchaseId])
}

/// One tube, block or slide, collected or produced by an experiment and used by later ones. Shares only the location tree with inventory.
model Sample {
  id                String                     @id @default(cuid())
  /// Unique across all samples: the type's prefix and a running number unless typed in.
  code              String                     @unique
  /// The lab's own name; it may repeat (an RNA and the cDNA made from it often share one).
  name              String
  typeId            String
  type              ScientificSchemaDefinition @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// The individual it comes from: a patient, an animal, a cell line and its treatment. Children inherit it.
  origin            String?
  parentId          String?
  parent            Sample?                    @relation("SampleLineage", fields: [parentId], references: [id], onDelete: Restrict)
  children          Sample[]                   @relation("SampleLineage")
  projectId         String?
  project           Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  locationId        String?
  location          InventoryLocation?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// A1-style inside a box with rows and columns, free text otherwise.
  position          String?
  amount            Float?
  amountUnit        String?
  concentration     Float?
  concentrationUnit String?
  status            SampleStatus               @default(available)
  biosafetyLevel    String?
  collectedAt       DateTime?
  fieldValues       Json                       @default("{}")
  notes             String?
  /// Samples saved together; the batch can be undone while none of them is used or derived from.
  batchId           String?
  /// The external sample bank a sample came from and its ID there; a later sync updates the same sample.
  externalSource    String?
  externalId        String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  experiments ExperimentSample[]

  @@unique([externalSource, externalId])
  @@unique([locationId, position])
  @@index([typeId])
  @@index([parentId])
  @@index([projectId])
  @@index([status])
  @@index([batchId])
  @@index([name])
}

/// An experiment's design groups (control / treated, tumour / normal). They do not split Protocol steps.
model ExperimentSampleGroup {
  id           String             @id @default(cuid())
  experimentId String
  experiment   Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  label        String
  sortOrder    Int                @default(0)
  samples      ExperimentSample[]

  @@unique([experimentId, label])
  @@index([experimentId, sortOrder])
}

/// A sample an experiment took (input) or produced (output), in the experiment's order.
model ExperimentSample {
  id           String                 @id @default(cuid())
  experimentId String
  experiment   Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  sampleId     String
  sample       Sample                 @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  role         ExperimentSampleRole
  groupId      String?
  group        ExperimentSampleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sortOrder    Int                    @default(0)
  /// What the experiment took; subtracted from the sample's amount when the units compare, given back when removed.
  usedAmount   Float?
  usedUnit     String?
  /// What was actually subtracted, in the sample's unit; null when nothing was.
  deducted     Float?
  createdAt    DateTime               @default(now())

  @@unique([experimentId, sampleId])
  @@index([sampleId])
  @@index([experimentId, role, sortOrder])
}

/// The connection to the lab's external sample bank (S17–S19); one row per bank, the settings page edits one.
model SampleBankConnection {
  id                     String              @id @default(cuid())
  /// The bank's short name, written on imported samples as their external source; fixed once a sample uses it.
  source                 String              @unique
  name                   String
  baseUrl                String
  /// Where the bank pushes results: this LabNest's address and /api/sample-bank/results.
  callbackUrl            String
  /// The bank's token, sent with every search; encrypted like an AI service key.
  outboundTokenEncrypted String?
  outboundTokenHint      String?
  /// LabNest's token, which the bank sends with each push and signs it with; encrypted.
  inboundTokenEncrypted  String?
  inboundTokenCreatedAt  DateTime?
  enabled                Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  searches               SampleBankSearch[]
  typeMaps               SampleBankTypeMap[]
}

enum SampleBankSearchStatus {
  sent
  accepted
  rejected
  receiving
  complete
  failed
}

/// One search sent to the bank and the pages it pushed back (S21).
model SampleBankSearch {
  id            String                 @id @default(cuid())
  requestId     String                 @unique
  connectionId  String
  connection    SampleBankConnection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  bankRequestId String?
  query         Json
  limit         Int
  /// A connection test: a one-record search whose pushed answer shows that results come back.
  test          Boolean                @default(false)
  requestedBy   String?
  status        SampleBankSearchStatus @default(sent)
  pageCount     Int?
  pagesReceived Int[]                  @default([])
  total         Int?
  error         Json?
  requestedAt   DateTime               @default(now())
  completedAt   DateTime?
  updatedAt     DateTime               @updatedAt
  records       SampleBankRecord[]
  imports       SampleBankImport[]

  @@index([connectionId, requestedAt])
}

/// A sample as the bank pushed it, kept as received.
model SampleBankRecord {
  id         String           @id @default(cuid())
  searchId   String
  search     SampleBankSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  page       Int
  source     String
  externalId String
  record     Json
  receivedAt DateTime         @default(now())

  @@unique([searchId, source, externalId])
  @@index([source, externalId])
}

/// A bank's own type word and the LabNest sample type it means (S27).
model SampleBankTypeMap {
  id           String                     @id @default(cuid())
  connectionId String
  connection   SampleBankConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// The bank's word as matchKey reads it.
  bankType     String
  typeId       String
  type         ScientificSchemaDefinition @relation(fields: [typeId], references: [id], onDelete: Cascade)
  createdAt    DateTime                   @default(now())

  @@unique([connectionId, bankType])
}

/// One import from a search. Its id is the batch of the samples it made; `updated` keeps what each updated sample was
/// before, so undoing the batch can put it back (S26).
model SampleBankImport {
  id         String           @id
  searchId   String
  search     SampleBankSearch @relation(fields: [searchId], references: [id], onDelete: Restrict)
  created    Int
  updated    Json             @default("[]")
  importedAt DateTime         @default(now())
  undoneAt   DateTime?
}

