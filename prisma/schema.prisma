  location        String?
  openedAt        DateTime?
  /// Kit components used up or missing in this box, by component ID; absent means present.
  componentStates Json                      @default("{}")
  version         Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  events          InventoryContainerEvent[]
  observations    InventoryObservation[]

  @@index([inventoryItemId, state])
}

model InventoryContainerEvent {
  id               String             @id @default(cuid())
  containerId      String
  container        InventoryContainer @relation(fields: [containerId], references: [id], onDelete: Restrict)
  action           String
  performedBy      String?
  snapshotJson     Json
  clientMutationId String             @unique
  createdAt        DateTime           @default(now())

  @@index([containerId, createdAt])
}

model InventoryObservation {
  id           String             @id @default(cuid())
  containerId  String
  container    InventoryContainer @relation(fields: [containerId], references: [id], onDelete: Restrict)
  remaining    Float
  unit         String
  quality      String
  performedBy  String
  experimentId String?
  experiment   Experiment?        @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())

  @@index([containerId, createdAt])
}

model PurchaseReceipt {
  id               String          @id @default(cuid())
  purchaseId       String
  purchase         PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  quantity         Float
  inventoryItemId  String?
  inventoryItem    InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  clientMutationId String          @unique
  createdAt        DateTime        @default(now())

  @@index([purchaseId])
}

model PurchaseExportSnapshot {
  id        String   @id @default(cuid())
  content   String
  format    String
  createdAt DateTime @default(now())
}

model RunMaterialUse {
  id              String                @id
  experimentId    String
  experiment      Experiment            @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  name            String
  expected        Float?
  actual          Float?
  unit            String
  source          String
  inventoryItemId String?
  inventoryItem   InventoryItem?        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  containerId     String?
  container       InventoryContainer?   @relation(fields: [containerId], references: [id], onDelete: Restrict)
  status          String                @default("recorded")
  transactionId   String?               @unique
  transaction     InventoryTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  correctionOfId  String?               @unique
  correctionOf    RunMaterialUse?       @relation("MaterialCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  correction      RunMaterialUse?       @relation("MaterialCorrection")
  error           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([experimentId])
}

/// 方案设计: a goal, what was found for it, the method cards and the draft it became. Fetched texts hang off it as attachments.
model MethodDesignSession {
  id             String   @id @default(cuid())
  goal           String
  sampleType     String?
  conditions     String?
  status         String   @default("searching")
  inputsJson     Json     @default("{}")
  hitsJson       Json     @default("[]")
  cardsJson      Json     @default("[]")
  chosenJson     Json     @default("[]")
  draftVersionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// 外部方法检索 is off by default and reaches outside only when the user searches.
model MethodSearchSettings {
  id                        String   @id @default("default")
  enabled                   Boolean  @default(false)
  sourcesJson               Json     @default("[\"local\"]")
  protocolsIoTokenEncrypted String?
  /// The web search key for 产品说明书 (Tavily), kept encrypted like the protocols.io token.
  webSearchKeyEncrypted     String?
  /// The vendor domains searched for manuals; empty means the default list.
  manualVendorsJson         Json?
  updatedAt                 DateTime @updatedAt
}

/// 研究方案 Copilot: one run from a research purpose to a design of experiments, kept with its log and suggestions.
model ResearchPlanCopilotRun {
  id              String       @id @default(cuid())
  researchPlanId  String
  researchPlan    ResearchPlan @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  purpose         String
  inputsJson      Json         @default("{}")
  status          String       @default("ready")
  stage           String       @default("split")
  autoContinue    Boolean      @default(true)
  budgetJson      Json         @default("{}")
  stateJson       Json         @default("{\"done\":[]}")
  logJson         Json         @default("[]")
  suggestionsJson Json         @default("[]")
  provider        String?
  model           String?
  modelCalls      Int          @default(0)
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([researchPlanId, createdAt])
}

/// One pass of the research-plan design workbench (plan-design-v1): context card → evidence chain → design cards →
/// review → sign-off. Each step's artifact lives in `stateJson`; the author confirms every step before the next one.
/// Superseded the literature-first ResearchPlanCopilotRun, whose rows stay readable.
model ResearchPlanDesignRun {
  id             String       @id @default(cuid())
  researchPlanId String
  researchPlan   ResearchPlan @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  spec           String       @default("plan-design-v1")
  purpose        String
  /// context | chain | cards | review | signed
  step           String       @default("context")
  /// idle (waiting for the author) | working | failed | signed
  status         String       @default("idle")
  stateJson      Json         @default("{}")
  logJson        Json         @default("[]")
  provider       String?
  model          String?
  modelCalls     Int          @default(0)
  error          String?
  signedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([researchPlanId, createdAt])
}

/// The fixed lifecycle 大类 of inventory: they can be renamed or hidden, never added or removed.
model InventoryGroup {
  key       String   @id
  label     String?
  hidden    Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  types    ScientificSchemaDefinition[]
  products InventoryProduct[]
}

/// One catalogue entry (brand + catalogue number) or one self-made design; inventory items are its lots.
model InventoryProduct {
  id               String                      @id @default(cuid())
  name             String
  englishName      String?
  brand            String?
  catalogNumber    String?
  casNumber        String?
  groupKey         String?
  group            InventoryGroup?             @relation(fields: [groupKey], references: [key], onDelete: Restrict)
  typeId           String?
  type             ScientificSchemaDefinition? @relation(fields: [typeId], references: [id], onDelete: Restrict)
  entityId         String?
  entity           Entity?                     @relation(fields: [entityId], references: [id], onDelete: SetNull)
  fieldValues      Json                        @default("{}")
  controlLevels    String[]                    @default([])
  lowThreshold     Float?
  lowThresholdUnit String?
  notes            String?
  status           ObjectStatus                @default(active)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  items         InventoryItem[]
  kitComponents InventoryKitComponent[]

  @@index([groupKey])
  @@index([typeId])
  @@index([catalogNumber])
  @@index([entityId])
  @@index([status])
}

/// A component every box of a kit product should contain.
model InventoryKitComponent {
  id               String           @id @default(cuid())
  productId        String
  product          InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  spec             String?
  storageCondition String?
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([productId, sortOrder])
}

/// Two products, or two stock lots, someone marked as not duplicates; stored with the smaller id first.
model InventoryDuplicateDismissal {
  firstId   String
  secondId  String
  createdAt DateTime @default(now())

  @@id([firstId, secondId])
}
